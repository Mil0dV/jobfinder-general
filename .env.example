# Environment variables for Job Vacancy Finder Agent

# LLM provider — "openrouter" (Kimi K3, default when OPENROUTER_API_KEY is set)
# or "anthropic" (Claude). Switch back to Claude by setting LLM_PROVIDER=anthropic
# (or removing OPENROUTER_API_KEY).
LLM_PROVIDER=openrouter

# OpenRouter (used when LLM_PROVIDER=openrouter — agent loop, job validation,
# cover letters, resume tailoring). Get a key at: https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here
# Optional model overrides. Main model handles cover letters / application
# answers; the fast model handles everything else (validation, agent loop,
# resume parsing/tailoring, salary estimates).
# OPENROUTER_MODEL=moonshotai/kimi-k3
# OPENROUTER_FAST_MODEL=deepseek/deepseek-v4-flash

# Local V100 llama rig (ik_llama.cpp): when the key is set and the rig answers
# at startup, cover letters + resume tailoring prefer MARVIN_MODEL (default
# gandalf @ http://marvin:8080/v1, or MARVIN_PREFERRED_MODEL when llama-swap has it loaded). Leave unset to disable.
MARVIN_KEY=your_marvin_llama_api_key_here
# MARVIN_BASE_URL=http://marvin:8080/v1
# MARVIN_MODEL=gandalf   # fallback; setting it explicitly pins the model
# MARVIN_PREFERRED_MODEL=qwen3.8-27b   # used instead when it is already loaded
# MARVIN_THINKING=low   # off | low | medium | high (rig reasoning_effort)
# MARVIN_TELLCHECK_THINKING=off   # thinking for tell-check/revision passes (drafting gains, flattening doesn't)

# Anthropic API (used when LLM_PROVIDER=anthropic)
# Get your API key from: https://platform.claude.com
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Adzuna API (optional, increases job quantity)
# Sign up for free at: https://developer.adzuna.com
# Free tier: 2500 calls/month
ADZUNA_APP_ID=your_adzuna_app_id
ADZUNA_API_KEY=your_adzuna_api_key

# climate.jobs session (optional — unlocks Remote Climate Jobs premium cards).
# Get it by requesting a magic-link login on climate.jobs and copying the
# cj_session cookie after clicking it. Without it, the free subset still works.
CLIMATEJOBS_SESSION=your_cj_session_cookie

# Firebase cross-device sync (optional — shares jobs/decisions with the Android app
# via Cloud Firestore). Setup with the Firebase CLI (`npx -y firebase-tools@latest login`):
#   1. `npx -y firebase-tools@latest projects:create <id>` (or reuse one; see .firebaserc)
#   2. `npx -y firebase-tools@latest firestore:databases:create "(default)" --location eur3`
#   3. `npx -y firebase-tools@latest deploy --only auth`   (enables Email/Password —
#      the provider config lives in firebase.json)
#   4. Create the user: POST identitytoolkit accounts:signUp with the API key, or
#      console > Authentication > Users > Add user (your email + long random password)
#   5. FIREBASE_API_KEY = any client API key of the project (e.g. "current_key" from
#      `npx -y firebase-tools@latest apps:sdkconfig ANDROID <APP_ID>`)
#   6. Run `uv run python sync.py` once — it prints your auth uid; put it in
#      firestore.rules and `npx -y firebase-tools@latest deploy --only firestore`
FIREBASE_API_KEY=your_firebase_client_api_key
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_EMAIL=you@example.com
FIREBASE_PASSWORD=your_firebase_user_password

# TypeSafe Jev (optional): typed climate score + "remote, US only" detection.
# Unset = the LLM validator alone. Key from https://docs.typesafe.ai
TYPESAFE_API_KEY=
