# Environment variables for Job Vacancy Finder Agent

# OpenAI Configuration
# Get your API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# Adzuna API (optional, increases job quantity)
# Sign up for free at: https://developer.adzuna.com
# Free tier: 2500 calls/month
ADZUNA_APP_ID=your_adzuna_app_id
ADZUNA_API_KEY=your_adzuna_api_key

# Anthropic API (for cover letter generation with Claude)
ANTHROPIC_API_KEY=your_anthropic_api_key_here
