rules_version = '2';

// Personal jobs-sync DB: locked to Milo's single auth user.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if request.auth != null
        && request.auth.uid == 'IKsFNRb5VogIjUJOpQVqjn6W3D92';
    }
  }
}
